apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  name: {{ kubernetes_hostname }}
  kubeletExtraArgs:
    - name: cloud-provider
      value: {{ kubernetes_cloud_provider | to_json }}
{% if kubernetes_taints is defined %}
  taints:
{{ kubernetes_taints | to_yaml | indent(4, true) }}
{%- endif -%}
localAPIEndpoint:
  advertiseAddress: {{ kubernetes_apiserver_advertise_address }}
  bindPort: 6443
patches:
  directory: {{ kubeadm_patches_path }}
skipPhases: {{ kubeadm_skip_phases | to_yaml | indent(2) }}
timeouts:
  controlPlaneComponentHealthCheck: 4m0s
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
etcd:
  external:
    endpoints:
{{ etcd.endpoints | to_nice_yaml | indent(4, true) }}
    caFile: {{ etcd.caFile }}
    certFile: {{ etcd.certFile }}
    keyFile: {{ etcd.keyFile }}
clusterName: {{ kubernetes_cluster_name }}
kubernetesVersion: {{ kubernetes_version }}
imageRepository: "{{ kubernetes_image_registry }}"
controlPlaneEndpoint: {{ kubernetes_control_plane_address }}
dns:
{% if coredns_image_prefix != "" %}
  imageRepository: {{ kubernetes_image_registry }}{{ coredns_image_prefix }}
{% endif %}
apiServer:
{% if kubernetes_apiserver_certSANs | length %}
  certSANs:
{{ kubernetes_apiserver_certSANs | to_nice_yaml | indent(2, true) -}}
{% endif %}
  extraArgs:
{% if tls_cipher_suites is defined %}
    - name: tls-cipher-suites
      value: {{ tls_cipher_suites | join(',') | to_json }}
{% endif %}
    - name: enable-admission-plugins
      value: {{ 'NamespaceLifecycle,LimitRanger,PodNodeSelector,ServiceAccount,DefaultStorageClass,DefaultTolerationSeconds,MutatingAdmissionWebhook,ValidatingAdmissionWebhook,ResourceQuota,EventRateLimit,NodeRestriction,DenyServiceExternalIPs' | to_json }}
    - name: admission-control-config-file
      value: {{ eventratelimit_config_file | default('/etc/kubernetes/admission-config.yaml') | to_json }}
{% if kubernetes_cloud_provider != "" and kubernetes_version is version('1.33.0', '<') %}
    - name: cloud-provider
      value: {{ kubernetes_cloud_provider | to_json }}
{% endif %}
    - name: kubelet-certificate-authority
      value: {{ kubelet_certificate_authority_file | default('/etc/kubernetes/pki/ca.crt') | to_json }}
    - name: request-timeout
      value: {{ '60s' | to_json }}
{% if kubernetes_cloud_config != "" and kubernetes_version is version('1.33.0', '<') %}
    - name: cloud-config
      value: {{ kubernetes_cloud_config | to_json }}
{% endif %}
    - name: audit-log-path
      value: {{ (audit_log_dir ~ '/kube-apiserver-audit.log') | to_json }}
    - name: audit-policy-file
      value: {{ audit_policy_config_path | to_json }}
    - name: audit-log-maxage
      value: {{ audit_policy_max_age | string | to_json }}
    - name: audit-log-maxsize
      value: {{ audit_policy_max_size | string | to_json }}
    - name: audit-log-maxbackup
      value: {{ audit_policy_max_backup | string | to_json }}
    - name: service-account-extend-token-expiration
      value: {{ 'false' | to_json }}
{% if kubernetes_encryption_config != "" %}
    - name: encryption-provider-config
      value: {{ kubernetes_remote_encryption_config | to_json }}
{% endif %}
{% if oidc_issuer_url != "" %}
{% if oidc_extra_audiences | default([]) | length > 0 %}
{# kube-apiserver rejects --authentication-config combined with any --oidc-* flag. #}
    - name: authentication-config
      value: {{ kubernetes_remote_authentication_config | to_json }}
{% else %}
    - name: oidc-issuer-url
      value: {{ oidc_issuer_url | to_json }}
    - name: oidc-client-id
      value: {{ oidc_client_id | to_json }}
    - name: oidc-ca-file
      value: {{ oidc_ca_file | to_json }}
    - name: oidc-username-claim
      value: {{ oidc_username_claim | to_json }}
    - name: oidc-username-prefix
      value: {{ oidc_username_prefix | to_json }}
    - name: oidc-groups-claim
      value: {{ oidc_groups_claim | to_json }}
    - name: oidc-groups-prefix
      value: {{ oidc_groups_prefix | to_json }}
{% endif %}
{% endif %}
{% if service_account_issuer is defined %}
    - name: service-account-issuer
      value: {{ service_account_issuer | to_json }}
{% endif %}
{% if api_audiences is defined %}
    - name: api-audiences
      value: {{ api_audiences | to_json }}
{% endif %}
    - name: profiling
      value: {{ 'false' | to_json }}
  extraVolumes:
  - name: audit-files
    hostPath: {{ audit_log_dir }}
    mountPath: {{ audit_log_dir }}
    readOnly: false
    pathType: Directory
  - name: audit-policy
    hostPath: {{ audit_policy_config_path }}
    mountPath: {{ audit_policy_config_path }}
    readOnly: true
    pathType: File
  - name: admission
    hostPath: {{ eventratelimit_config_file | default('/etc/kubernetes/admission-config.yaml') }}
    mountPath: {{ eventratelimit_config_file | default('/etc/kubernetes/admission-config.yaml') }}
    readOnly: true
    pathType: File
{% if kubernetes_encryption_config != "" %}
  - name: encryption-configuration
    hostPath: {{ kubernetes_remote_encryption_config }}
    mountPath: {{ kubernetes_remote_encryption_config }}
    readOnly: true
    pathType: File
{% endif %}
{% if oidc_issuer_url != "" and oidc_extra_audiences | default([]) | length > 0 %}
  - name: authentication-config
    hostPath: {{ kubernetes_remote_authentication_config }}
    mountPath: {{ kubernetes_remote_authentication_config }}
    readOnly: true
    pathType: File
{% endif %}
{% if kubernetes_cloud_config != "" and kubernetes_version is version('1.33.0', '<') %}
  - name: cloud
    hostPath: {{ kubernetes_cloud_config }}
    mountPath: {{ kubernetes_cloud_config }}
    readOnly: true
    pathType: File
{% endif %}
scheduler:
  extraArgs:
{% if tls_cipher_suites is defined %}
    - name: tls-cipher-suites
      value: {{ tls_cipher_suites | join(',') | to_json }}
{% endif %}
    - name: profiling
      value: {{ 'false' | to_json }}
controllerManager:
  extraArgs:
{% if tls_cipher_suites is defined %}
    - name: tls-cipher-suites
      value: {{ tls_cipher_suites | join(',') | to_json }}
{% endif %}
    - name: cloud-provider
      value: {{ kubernetes_cloud_provider | to_json }}
{% if kubernetes_cloud_config != "" %}
    - name: cloud-config
      value: {{ kubernetes_cloud_config | to_json }}
{% endif %}
# Disables profiling (always false by default)
    - name: profiling
      value: {{ 'false' | to_json }}
# Reduced default value for maximum number of terminated pods kept by the controller-manager before removal (default 12500)
{% if terminated_pod_gc_threshold is defined %}
    - name: terminated-pod-gc-threshold
      value: {{ terminated_pod_gc_threshold | string | to_json }}
{% endif %}
{% if kubernetes_cloud_config != "" %}
  extraVolumes:
  - name: cloud
    hostPath: {{ kubernetes_cloud_config }}
    mountPath: {{ kubernetes_cloud_config }}
    readOnly: true
    pathType: File
{% endif %}
networking:
  podSubnet: {{ kubernetes_pod_cidr }}
  serviceSubnet: {{ kubernetes_svc_cidr }}
  dnsDomain: "cluster.local"
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
bindAddress: 0.0.0.0
clusterCIDR: "{{ kubernetes_pod_cidr }}"
{% if kubernetes_kube_proxy_mode == 'ipvs' %}
ipvs:
  excludeCIDRs: null
  minSyncPeriod: 0s
  scheduler: ""
  syncPeriod: 30s
{% endif %}
metricsBindAddress: 0.0.0.0:10249
mode: {{ kubernetes_kube_proxy_mode }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
{% if kubelet_tls_cipher_suites is defined %}
tlsCipherSuites: {{ kubelet_tls_cipher_suites | to_yaml | indent(2) }}
{% endif %}
