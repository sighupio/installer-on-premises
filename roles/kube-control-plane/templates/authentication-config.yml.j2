# Structured-authentication equivalent of the legacy --oidc-* flags, rendered only when
# oidc_extra_audiences is non-empty (see kubeadm.yml.j2 and defaults/main.yml).

{% if kubernetes_version is version('1.34.0', '>=', version_type='semver') %}
apiVersion: apiserver.config.k8s.io/v1
{% else %}
apiVersion: apiserver.config.k8s.io/v1beta1
{% endif %}
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: {{ oidc_issuer_url | to_json }}
      certificateAuthority: {{ oidc_ca_content.content | b64decode | to_json }}
      audiences:
        - {{ oidc_client_id | to_json }}
{% for audience in oidc_extra_audiences %}
        - {{ audience | to_json }}
{% endfor %}
      audienceMatchPolicy: MatchAny
    claimMappings:
      username:
        claim: {{ oidc_username_claim | to_json }}
{# Replicates the legacy --oidc-username-prefix default: an empty prefix with a claim
   other than email used to get an implicit issuerURL# prefix from kube-apiserver.
   The structured config has no such default, so we add it back here. #}
{% if oidc_username_prefix == "-" %}
        prefix: {{ "" | to_json }}
{% elif oidc_username_prefix == "" and oidc_username_claim != "email" %}
        prefix: {{ (oidc_issuer_url ~ "#") | to_json }}
{% else %}
        prefix: {{ oidc_username_prefix | to_json }}
{% endif %}
      groups:
        claim: {{ oidc_groups_claim | to_json }}
{# Unlike --oidc-username-prefix, the legacy --oidc-groups-prefix flag never treated "-" as a
   sentinel for no prefix: it was always a literal value. Pass it through unchanged. #}
        prefix: {{ oidc_groups_prefix | to_json }}
