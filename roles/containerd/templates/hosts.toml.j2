# Hosts are tried in order, then containerd falls back to the registry itself: an
# empty or missing server is replaced with the image's own registry, so that fallback
# cannot be disabled here. See https://github.com/containerd/containerd/blob/main/docs/hosts.md

{% if item.mirror_endpoint is defined %}
{% for endpoint in item.mirror_endpoint %}
[host."{{ endpoint }}"]
  capabilities = ["pull", "resolve"]
  skip_verify = {{ item.insecure_skip_verify | default(false) | bool | lower }}
{% endfor %}
{% endif %}
